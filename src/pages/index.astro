---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import ServiceSelect from '../components/ServiceSelect.astro';
import { company, services, clients, testimonials, whatsappUrl } from '../data/company';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const image = (name: string) => `${base}/images/${name}`;
const steps = [
  [
    'Escuchamos tu proyecto',
    'Conocemos tus necesidades, el tipo de instalación y los objetivos de seguridad.',
  ],
  [
    'Evaluamos y diseñamos',
    'Estudiamos las condiciones del terreno para definir una solución a tu medida.',
  ],
  [
    'Ejecutamos con precisión',
    'Instalamos el sistema con materiales y procedimientos adecuados para tu proyecto.',
  ],
  ['Medimos y verificamos', 'Realizamos pruebas y documentamos los resultados de la instalación.'],
  ['Cuidamos tu inversión', 'Te acompañamos con asesoría y mantenimiento preventivo y correctivo.'],
];
---

<Layout>
  <main id="contenido">
    <section class="hero" id="inicio" aria-labelledby="hero-title">
      <img
        class="hero-image"
        src={image('arquitectura.jpg')}
        alt="Arquitectura contemporánea de líneas precisas y fachadas de vidrio"
        width="1920"
        height="1280"
        fetchpriority="high"
      />
      <div class="hero-shade"></div>
      <div class="hero-content">
        <span class="eyebrow">
          <span class="status-dot"></span> INGENIERÍA CON PROPÓSITO
        </span>
        <h1 id="hero-title">
          La seguridad
          <br />
          de tu proyecto
          <br />
          <em>empieza en la base.</em>
        </h1>
        <p>
          Soluciones de puesta a tierra que protegen tus instalaciones y lo que más importa: las
          personas.
        </p>
        <a class="button" href={whatsappUrl()} target="_blank" rel="noopener noreferrer">
          Conversemos sobre tu proyecto <Icon name="diagonal" size={18} />
        </a>
      </div>
      <div class="hero-bottom">
        <span>DISEÑO · INSTALACIÓN · MANTENIMIENTO</span>
        <a href="#nosotros">
          Descubre SDI <span>↓</span>
        </a>
      </div>
      <div class="hero-index" aria-hidden="true">
        01 <span>/</span> SEGURIDAD DESDE LA BASE
      </div>
    </section>

    <section class="about section" id="nosotros" aria-labelledby="about-title">
      <div class="about-copy">
        <span class="eyebrow">01 / NOSOTROS</span>
        <h2 id="about-title">
          Una empresa familiar.
          <br />
          <span>Un compromiso sólido.</span>
        </h2>
        <p>
          Somos SDI Ingenieros SA, también conocidos como SDISA. Nos dedicamos a la construcción y
          mantenimiento de sistemas de puesta a tierra verticales y horizontales.
        </p>
        <p>
          Combinamos el conocimiento de nuestros colaboradores con exigentes estándares de calidad
          para acompañarte en cada etapa de tu proyecto.
        </p>
        <a class="text-link" href="#como-trabajamos">
          Conoce cómo trabajamos <Icon name="arrow" size={18} />
        </a>
      </div>
      <div class="about-principles">
        <div>
          <span class="principle-number">01</span>
          <h3>Seguridad</h3>
          <p>Protección para las personas y las instalaciones.</p>
        </div>
        <div>
          <span class="principle-number">02</span>
          <h3>Precisión</h3>
          <p>Soluciones según el terreno y cada necesidad.</p>
        </div>
        <div>
          <span class="principle-number">03</span>
          <h3>Compromiso</h3>
          <p>Presupuestos claros y entrega responsable.</p>
        </div>
        <div>
          <span class="principle-number">04</span>
          <h3>Confianza</h3>
          <p>Cercanía y transparencia en todo el proceso.</p>
        </div>
      </div>
    </section>

    <section class="clients" aria-label="Clientes de SDI">
      <span class="eyebrow">CONFIANZA QUE NOS IMPULSA</span>
      <div class="client-row">
        {clients.slice(0, 4).map((client, index) => (
          <span>
            <span class="client-symbol" aria-hidden="true">
              {['✳', '◈', '⊕', '▥'][index]}
            </span>
            {client}
          </span>
        ))}
      </div>
    </section>

    <section class="services section" id="servicios" aria-labelledby="services-title">
      <div class="section-heading">
        <div>
          <span class="eyebrow">02 / LO QUE HACEMOS</span>
          <h2 id="services-title">
            Ingeniería a tierra.
            <br />
            <span>Tranquilidad para ti.</span>
          </h2>
        </div>
        <p>
          Una solución integral, desde el primer estudio hasta el mantenimiento de tus
          instalaciones.
        </p>
      </div>
      <div class="service-showcase">
        <a href="#verticales" class="image-card">
          <img
            src={image('puesta-a-tierra.jpg')}
            alt="Trabajos de instalación de un sistema de puesta a tierra de SDI"
            width="1280"
            height="960"
            loading="lazy"
          />
          <div>
            <span>01 / INSTALACIÓN</span>
            <h3>
              La protección se construye
              <br />
              desde abajo.
            </h3>
            <span class="circle-arrow">
              <Icon name="diagonal" />
            </span>
          </div>
        </a>
        <a href="#mediciones" class="image-card">
          <img
            src={image('medicion.jpg')}
            alt="Equipo de medición utilizado en los servicios de puesta a tierra"
            width="1280"
            height="960"
            loading="lazy"
          />
          <div>
            <span>02 / DIAGNÓSTICO</span>
            <h3>
              Precisión que marca
              <br />
              la diferencia.
            </h3>
            <span class="circle-arrow">
              <Icon name="diagonal" />
            </span>
          </div>
        </a>
      </div>
      <div class="service-grid">
        {services.map((service, index) => (
          <article class="service" id={service.id}>
            <div class="service-top">
              <Icon name={service.icon} size={29} />
              <span>0{index + 1}</span>
            </div>
            <span class="eyebrow">{service.category}</span>
            <h3>{service.title}</h3>
            <p>{service.brief}</p>
            <details>
              <summary>
                Conoce el servicio <span>+</span>
              </summary>
              <p>{service.description}</p>
            </details>
            <a
              class="text-link"
              href={whatsappUrl(
                `Hola, SDI Ingenieros. Quisiera información y una cotización sobre ${service.title.toLowerCase()}.`,
              )}
              target="_blank"
              rel="noopener noreferrer"
            >
              Consultar por WhatsApp <Icon name="diagonal" size={16} />
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="purpose section">
      <span class="eyebrow">LO QUE NOS MUEVE</span>
      <div>
        <article>
          <span>NUESTRA MISIÓN</span>
          <h3>
            Construir seguridad.
            <br />
            Mantener la confianza.
          </h3>
          <p>
            Ser una empresa dedicada a los servicios de construcción y mantenimiento de sistemas de
            puesta a tierra.
          </p>
        </article>
        <article>
          <span>NUESTRA VISIÓN</span>
          <h3>
            Que la calidad
            <br />
            hable por nosotros.
          </h3>
          <p>Ser una empresa reconocida por la calidad de sus servicios.</p>
        </article>
      </div>
      <p class="values-line">
        Confianza y transparencia <span>·</span> Innovación y excelencia <span>·</span> Éxito del
        cliente
      </p>
    </section>

    <section class="process section" id="como-trabajamos" aria-labelledby="process-title">
      <div class="process-intro">
        <span class="eyebrow">03 / CÓMO TRABAJAMOS</span>
        <h2 id="process-title">
          Contigo en
          <br />
          <span>cada etapa.</span>
        </h2>
        <p>Un proceso claro. Un equipo cercano. La misma dedicación de principio a fin.</p>
        <div class="process-photo">
          <img
            src={image('arquitectura.jpg')}
            alt="Detalle de una fachada contemporánea de vidrio"
            width="640"
            height="760"
            loading="lazy"
          />
          <a href={whatsappUrl()} target="_blank" rel="noopener noreferrer">
            Tu proyecto,
            <br />
            nuestro compromiso
          </a>
        </div>
      </div>
      <ol class="steps">
        {steps.map(([title, text], index) => (
          <li>
            <span class="step-number">0{index + 1}</span>
            <div>
              <h3>{title}</h3>
              <p>{text}</p>
            </div>
            <Icon name="diagonal" size={18} />
          </li>
        ))}
      </ol>
    </section>

    <section class="experience section" id="experiencia" aria-labelledby="experience-title">
      <div class="section-heading">
        <div>
          <span class="eyebrow">04 / NUESTRA EXPERIENCIA</span>
          <h2 id="experience-title">
            Personas detrás
            <br />
            <span>de cada solución.</span>
          </h2>
        </div>
        <p>
          Conocimiento técnico, trabajo en campo y una forma de hacer las cosas que nace del
          compromiso familiar.
        </p>
      </div>
      <figure class="team-photo">
        <img
          src={image('equipo-sdi.jpg')}
          alt="Archivo de SDI Ingenieros: equipo, instalaciones industriales y experiencia de trabajo en campo"
          width="1280"
          height="720"
          loading="lazy"
        />
        <figcaption>
          SDI Ingenieros <span>Experiencia en campo y compromiso con cada proyecto.</span>
        </figcaption>
      </figure>
      <div class="all-clients">
        <span class="eyebrow">EMPRESAS E INSTITUCIONES QUE CONFÍAN EN SDI</span>
        <div>
          {clients.map((client) => (
            <span>{client}</span>
          ))}
        </div>
      </div>
    </section>

    <section class="testimonials section" aria-labelledby="testimonials-title">
      <div class="section-heading">
        <div>
          <span class="eyebrow">LA VOZ DE NUESTROS CLIENTES</span>
          <h2 id="testimonials-title">
            La confianza
            <br />
            <span>se construye juntos.</span>
          </h2>
        </div>
        <div class="slider-buttons">
          <button type="button" data-testimonial-prev aria-label="Testimonios anteriores">
            <Icon name="chevron" size={21} />
          </button>
          <button type="button" data-testimonial-next aria-label="Más testimonios">
            <Icon name="chevron" size={21} />
          </button>
        </div>
      </div>
      <div class="testimonial-track" tabindex="0" aria-label="Testimonios de clientes">
        {testimonials.map((t) => (
          <figure class="testimonial">
            <span class="quote-mark" aria-hidden="true">
              “
            </span>
            <blockquote>{t.quote}</blockquote>
            <figcaption>
              <span class="avatar" aria-hidden="true">
                {t.author
                  .replace(/^(Dra?\.)\s*/, '')
                  .split(' ')
                  .map((w) => w[0])
                  .join('')
                  .slice(0, 2)}
              </span>
              <div>
                <strong>{t.author}</strong>
                <span>{t.role}</span>
                <span>{t.company}</span>
              </div>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <Faq />

    <section class="contact section" id="contacto" aria-labelledby="contact-title">
      <div class="contact-copy">
        <span class="eyebrow">
          <span class="status-dot"></span> EMPECEMOS ALGO SÓLIDO
        </span>
        <h2 id="contact-title">
          Tu próximo proyecto
          <br />
          merece una
          <br />
          <em>base segura.</em>
        </h2>
        <p>
          Cuéntanos qué necesitas. Nuestro equipo te ayudará a encontrar la solución de puesta a
          tierra adecuada.
        </p>
        <div class="contact-links">
          <a href={`mailto:${company.email}`}>
            <Icon name="mail" size={19} />
            {company.email}
          </a>
          <a href={`tel:+${company.whatsapp}`}>
            <Icon name="chat" size={19} />
            {company.phone}
          </a>
          <a
            href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(company.address + ', Lima, Perú')}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="pin" size={19} />
            {company.address}
          </a>
        </div>
      </div>
      <form class="contact-form" id="inquiry-form">
        <h3>Conversemos sobre tu proyecto</h3>
        <p>Prepara tu consulta y envíala directamente por WhatsApp.</p>
        <label for="name">
          Tu nombre
          <span class="field-control">
            <Icon name="person" size={19} />
            <input
              id="name"
              name="name"
              autocomplete="name"
              placeholder="¿Cómo te llamas?"
              required
              maxlength="100"
            />
          </span>
        </label>
        <ServiceSelect />
        <label for="message">
          Cuéntanos un poco más <span>(opcional)</span>
          <span class="field-control field-message">
            <Icon name="message" size={19} />
            <textarea
              id="message"
              name="message"
              rows="3"
              maxlength="1500"
              placeholder="Ubicación, tipo de instalación o detalles de tu proyecto…"
            ></textarea>
          </span>
        </label>
        <button type="submit" class="button button-white">
          Enviar consulta por WhatsApp <Icon name="diagonal" size={18} />
        </button>
        <small>Se abrirá WhatsApp con tu mensaje. Tú decides cuándo enviarlo.</small>
        <noscript>
          <a href={whatsappUrl()}>Continuar directamente en WhatsApp ↗</a>
        </noscript>
      </form>
    </section>
  </main>
  <script>
    import '../scripts/service-select';
    import { whatsappUrl } from '../data/company';
    const form = document.querySelector<HTMLFormElement>('#inquiry-form');
    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const data = new FormData(form);
      const name = String(data.get('name') || '').trim();
      if (!name) {
        const input = form.querySelector<HTMLInputElement>('#name');
        input?.setCustomValidity('Por favor, escribe tu nombre.');
        input?.reportValidity();
        return;
      }
      const message = `Hola, SDI Ingenieros. Mi nombre es ${name}. Me interesa el servicio de ${data.get('service')}.${data.get('message') ? `\n\n${String(data.get('message')).trim()}` : ''}`;
      window.location.assign(whatsappUrl(message));
    });
    form
      ?.querySelector('#name')
      ?.addEventListener('input', (event) =>
        (event.target as HTMLInputElement).setCustomValidity(''),
      );
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const revealItems = document.querySelectorAll<HTMLElement>(
      '.section-heading, .about-copy, .about-principles > div, .image-card, .service, .purpose article, .process-intro, .steps li, .team-photo, .all-clients, .faq > div:first-child, .contact-copy, .contact-form',
    );
    if (!motionQuery.matches && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) =>
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }),
        { threshold: 0.08 },
      );
      revealItems.forEach((item, index) => {
        item.classList.add('reveal');
        item.style.setProperty('--reveal-delay', (index % 3) * 65 + 'ms');
        observer.observe(item);
      });
      motionQuery.addEventListener('change', (event) => {
        if (event.matches) {
          observer.disconnect();
          revealItems.forEach((item) => item.classList.add('is-visible'));
        }
      });
    }
    const track = document.querySelector<HTMLElement>('.testimonial-track');
    const move = (direction: number) => {
      const card = track?.querySelector<HTMLElement>('.testimonial');
      if (track && card)
        track.scrollBy({
          left: direction * (card.offsetWidth + 24),
          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches
            ? 'instant'
            : 'smooth',
        });
    };
    document.querySelector('[data-testimonial-prev]')?.addEventListener('click', () => move(-1));
    document.querySelector('[data-testimonial-next]')?.addEventListener('click', () => move(1));
  </script>
</Layout>
