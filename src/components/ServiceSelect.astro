---
import Icon from './Icon.astro';
import { services } from '../data/company';
---

<div class="service-field">
  <label id="service-label" for="service">
    ¿Qué servicio necesitas?
  </label>
  <div class="field-control field-select">
    <Icon name="plan" size={19} />
    <select id="service" name="service" required>
      <option value="" data-placeholder="true">
        Selecciona un servicio
      </option>
      {services.map((service) => (
        <option>{service.title}</option>
      ))}
      <option>Quiero asesoría para mi proyecto</option>
    </select>
    <Icon name="chevron" size={16} />
  </div>
  <span id="service-error" class="field-error" aria-live="polite" hidden>
    Selecciona un servicio para continuar.
  </span>
</div>
