---
import Icon from './Icon.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const photos = [
  {
    file: 'equipo-sdi.jpg',
    title: 'Experiencia en campo',
    category: 'NUESTRO EQUIPO',
    description: 'Personas comprometidas con la seguridad y la calidad en cada etapa.',
    alt: 'Integrantes del equipo en una instalación industrial',
    crop: [90, 36, 285, 330],
  },
  {
    file: 'puesta-a-tierra.jpg',
    title: 'Seguridad desde la base',
    category: 'PUESTA A TIERRA',
    description: 'Trabajo técnico en la construcción de sistemas de puesta a tierra.',
    alt: 'Instalación de un sistema de puesta a tierra de SDI',
  },
  {
    file: 'medicion.jpg',
    title: 'Precisión en cada medición',
    category: 'PRUEBAS Y MEDICIONES',
    description: 'Evaluamos las instalaciones con equipos de medición especializados.',
    alt: 'Equipo de medición de resistencia de puesta a tierra',
  },
  {
    file: 'equipo-sdi.jpg',
    title: 'Compromiso con la ingeniería',
    category: 'ARCHIVO DE SDI',
    description: 'Conocimiento y experiencia junto a las instalaciones industriales.',
    alt: 'Instalación industrial del archivo fotográfico de SDI',
    crop: [892, 353, 350, 225],
  },
];
// Display individual photographs from the existing archive without altering the original file.
const cropStyle = (crop?: number[]) =>
  crop
    ? `--crop-ratio:${crop[2] / crop[3]};--crop-width:${(1280 / crop[2]) * 100}%;--crop-left:${(-crop[0] / crop[2]) * 100}%;--crop-top:${(-crop[1] / crop[3]) * 100}%`
    : undefined;
---

<div
  class="experience-carousel"
  role="region"
  aria-roledescription="carrusel"
  aria-label="Fotografías de la experiencia de SDI"
  tabindex="0"
>
  <div class="experience-stage">
    {photos.map((photo, index) => (
      <figure
        class:list={['experience-slide', { 'is-active': index === 0 }]}
        role="group"
        aria-roledescription="diapositiva"
        aria-label={`${index + 1} de ${photos.length}`}
        aria-hidden={index !== 0}
      >
        <div class="experience-visual">
          <div
            class:list={['experience-photo', { 'archive-photo': photo.crop }]}
            style={cropStyle(photo.crop)}
          >
            <img
              src={`${base}/images/${photo.file}`}
              alt={photo.alt}
              width={photo.crop ? 1280 : undefined}
              height={photo.crop ? 720 : undefined}
              loading="lazy"
              draggable="false"
            />
          </div>
          <span class="experience-stamp">
            <span></span> ARCHIVO FOTOGRÁFICO / SDI
          </span>
        </div>
        <figcaption class="experience-caption">
          <span class="experience-number" aria-hidden="true">
            0{index + 1}
            <span> / 0{photos.length}</span>
          </span>
          <span class="eyebrow">{photo.category}</span>
          <h3>{photo.title}</h3>
          <p>{photo.description}</p>
          <span class="experience-signature">
            SDI INGENIEROS <Icon name="diagonal" size={18} />
          </span>
        </figcaption>
      </figure>
    ))}
  </div>
  <div class="experience-controls" hidden>
    <div class="experience-thumbnails" aria-label="Elegir fotografía">
      {photos.map((photo, index) => (
        <button
          type="button"
          class:list={['experience-thumbnail', { 'is-current': index === 0 }]}
          aria-label={`Ver foto ${index + 1}: ${photo.title}`}
          aria-pressed={index === 0}
          data-slide={index}
        >
          <span
            class:list={['experience-photo', { 'archive-photo': photo.crop }]}
            style={cropStyle(photo.crop)}
          >
            <img src={`${base}/images/${photo.file}`} alt="" loading="lazy" draggable="false" />
          </span>
          <span class="thumbnail-number">0{index + 1}</span>
        </button>
      ))}
    </div>
    <span class="experience-status sr-only" aria-live="polite" aria-atomic="true"></span>
    <div class="experience-navigation">
      <button
        type="button"
        class="experience-play"
        aria-label="Pausar reproducción automática"
        aria-pressed="false"
      >
        <Icon name="pause" size={17} />
      </button>
      <span class="experience-count" aria-hidden="true">
        01 <span>/ 04</span>
      </span>
      <button type="button" class="experience-prev" aria-label="Fotografía anterior">
        <Icon name="chevron" size={21} />
      </button>
      <button type="button" class="experience-next" aria-label="Fotografía siguiente">
        <Icon name="chevron" size={21} />
      </button>
    </div>
  </div>
  <div class="experience-progress" aria-hidden="true">
    <span></span>
  </div>
</div>

<script>
  const carousel = document.querySelector<HTMLElement>('.experience-carousel');
  if (carousel) {
    const slides = [...carousel.querySelectorAll<HTMLElement>('.experience-slide')];
    const thumbnails = [...carousel.querySelectorAll<HTMLButtonElement>('[data-slide]')];
    const controls = carousel.querySelector<HTMLElement>('.experience-controls');
    const play = carousel.querySelector<HTMLButtonElement>('.experience-play');
    const count = carousel.querySelector<HTMLElement>('.experience-count');
    const status = carousel.querySelector<HTMLElement>('.experience-status');
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let index = 0;
    let paused = motion.matches;
    let visible = false;
    let hovering = false;
    let timer: number | undefined;
    const schedule = () => {
      window.clearTimeout(timer);
      carousel.classList.remove('is-playing');
      if (
        paused ||
        !visible ||
        hovering ||
        document.hidden ||
        carousel.contains(document.activeElement) ||
        motion.matches
      )
        return;
      carousel.getBoundingClientRect();
      carousel.classList.add('is-playing');
      timer = window.setTimeout(() => go(index + 1, false), 6500);
    };
    const go = (next: number, announce = true) => {
      index = (next + slides.length) % slides.length;
      slides.forEach((slide, position) => {
        slide.classList.toggle('is-active', position === index);
        slide.setAttribute('aria-hidden', String(position !== index));
      });
      thumbnails.forEach((button, position) => {
        button.classList.toggle('is-current', position === index);
        button.setAttribute('aria-pressed', String(position === index));
      });
      if (count) count.innerHTML = `0${index + 1} <span>/ 0${slides.length}</span>`;
      if (status && announce)
        status.textContent = `Fotografía ${index + 1} de ${slides.length}: ${slides[index].querySelector('h3')?.textContent}`;
      schedule();
    };
    const updatePlay = () => {
      if (play) play.disabled = motion.matches;
      play?.setAttribute(
        'aria-label',
        motion.matches
          ? 'Reproducción automática desactivada por movimiento reducido'
          : paused
            ? 'Reanudar reproducción automática'
            : 'Pausar reproducción automática',
      );
      play?.setAttribute('aria-pressed', String(paused));
      carousel.classList.toggle('is-paused', paused);
      schedule();
    };
    if (controls) controls.hidden = false;
    carousel.querySelector('.experience-prev')?.addEventListener('click', () => go(index - 1));
    carousel.querySelector('.experience-next')?.addEventListener('click', () => go(index + 1));
    thumbnails.forEach((button, position) => button.addEventListener('click', () => go(position)));
    play?.addEventListener('click', () => {
      paused = !paused;
      updatePlay();
    });
    carousel.addEventListener('keydown', (event) => {
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault();
      go(
        event.key === 'Home'
          ? 0
          : event.key === 'End'
            ? slides.length - 1
            : index + (event.key === 'ArrowRight' ? 1 : -1),
      );
    });
    let touchX = 0;
    let touchY = 0;
    const stage = carousel.querySelector<HTMLElement>('.experience-stage');
    stage?.addEventListener(
      'touchstart',
      (event) => {
        touchX = event.changedTouches[0].clientX;
        touchY = event.changedTouches[0].clientY;
      },
      { passive: true },
    );
    stage?.addEventListener(
      'touchend',
      (event) => {
        const dx = event.changedTouches[0].clientX - touchX;
        const dy = event.changedTouches[0].clientY - touchY;
        if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy)) go(index + (dx < 0 ? 1 : -1));
      },
      { passive: true },
    );
    carousel.addEventListener('pointerenter', (event) => {
      if (event.pointerType === 'mouse') {
        hovering = true;
        schedule();
      }
    });
    carousel.addEventListener('pointerleave', () => {
      hovering = false;
      schedule();
    });
    carousel.addEventListener('focusin', schedule);
    carousel.addEventListener('focusout', () => window.setTimeout(schedule, 0));
    document.addEventListener('visibilitychange', schedule);
    motion.addEventListener('change', () => {
      if (motion.matches) paused = true;
      updatePlay();
    });
    const observer = new IntersectionObserver(
      (entries) => {
        visible = entries[0].isIntersecting;
        schedule();
      },
      { threshold: 0.3 },
    );
    observer.observe(carousel);
    updatePlay();
  }
</script>

<style>
  .experience-carousel {
    --duration: 6500ms;
    position: relative;
    border-radius: 20px;
    background: #15364e;
    color: #f1f8fd;
    overflow: hidden;
    box-shadow: 0 16px 48px #1e486529;
  }
  .experience-stage {
    display: grid;
    touch-action: pan-y;
  }
  .experience-slide {
    grid-area: 1 / 1;
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateX(18px);
    transition:
      opacity 0.65s,
      transform 0.65s,
      visibility 0.65s;
  }
  .experience-slide.is-active {
    opacity: 1;
    visibility: visible;
    transform: translateX(0);
    pointer-events: auto;
  }
  .experience-visual {
    --visual-height: 440px;
    height: var(--visual-height);
    position: relative;
    overflow: hidden;
    background: #102b43;
    display: grid;
    place-items: center;
  }
  .experience-photo {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    transition:
      transform 1s cubic-bezier(0.2, 0.6, 0.3, 1),
      filter 0.6s;
  }
  .experience-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .archive-photo {
    height: auto;
    aspect-ratio: var(--crop-ratio);
  }
  .experience-visual > .archive-photo {
    width: max(100%, calc(var(--visual-height) * var(--crop-ratio)));
  }
  .archive-photo img {
    position: absolute;
    max-width: none;
    width: var(--crop-width);
    height: auto;
    left: var(--crop-left);
    top: var(--crop-top);
  }
  .experience-visual::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, #0c273dab, transparent 40%);
    pointer-events: none;
  }
  .experience-stamp {
    position: absolute;
    bottom: 24px;
    left: 26px;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 8px;
    letter-spacing: 0.15em;
    color: white;
    text-shadow: 0 1px 6px #0009;
  }
  .experience-stamp > span {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #b9ddf3;
  }
  .experience-caption {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 38px;
    background: radial-gradient(ellipse at top right, #365f7c, transparent 80%);
  }
  .experience-number {
    font-family: 'Manrope', sans-serif;
    font-size: 55px;
    letter-spacing: -0.06em;
    color: #a8c9e0;
    line-height: 1;
    margin-bottom: auto;
  }
  .experience-number > span {
    font-size: 12px;
    letter-spacing: 0.04em;
    color: #789db7;
  }
  .experience-caption .eyebrow {
    font-size: 8px;
    color: #abc8dc;
    margin: 26px 0 12px;
  }
  .experience-caption h3 {
    font-size: clamp(24px, 2.8vw, 36px);
    line-height: 1.15;
    margin-bottom: 18px;
  }
  .experience-caption p {
    color: #b8cddd;
    font-size: 12px;
    max-width: 250px;
  }
  .experience-signature {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid #a8c9e030;
    padding-top: 20px;
    margin-top: auto;
    font-size: 8px;
    letter-spacing: 0.13em;
    color: #c5dbea;
  }
  .experience-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 20px 26px;
  }
  .experience-controls[hidden] {
    display: none;
  }
  .experience-thumbnails {
    display: flex;
    gap: 10px;
  }
  .experience-thumbnail {
    width: 67px;
    height: 45px;
    overflow: hidden;
    position: relative;
    border: 2px solid transparent;
    padding: 0;
    background: #102b43;
    border-radius: 7px;
    opacity: 0.5;
    transition:
      opacity 0.3s,
      transform 0.3s,
      border-color 0.3s;
  }
  .experience-thumbnail.is-current {
    border-color: #a8d5f4;
    opacity: 1;
  }
  .thumbnail-number {
    position: absolute;
    bottom: 3px;
    left: 5px;
    font-size: 8px;
    color: #fff;
    text-shadow: 0 1px 5px #000;
  }
  .experience-navigation {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .experience-navigation button {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border: 1px solid #96bbd64d;
    border-radius: 50%;
    background: #accfe012;
    color: #dfedf7;
    transition:
      background 0.25s,
      transform 0.25s,
      box-shadow 0.25s;
  }
  .experience-navigation .experience-play {
    width: 32px;
    height: 32px;
    border: 0;
  }
  .experience-prev :global(svg) {
    rotate: 180deg;
  }
  .experience-count {
    font-size: 12px;
    letter-spacing: 0.1em;
    margin-right: 10px;
  }
  .experience-count > span {
    color: #85a8c2;
    font-size: 10px;
  }
  .experience-progress {
    height: 3px;
    background: #98b9cf24;
  }
  .experience-progress > span {
    display: block;
    height: 100%;
    width: 0;
    background: #98c9e9;
  }
  .is-playing .experience-progress > span {
    animation: carousel-progress var(--duration) linear forwards;
  }
  .is-paused .experience-play :global(svg) {
    display: none;
  }
  .is-paused .experience-play::after {
    content: '';
    border-left: 9px solid currentColor;
    border-top: 6px solid transparent;
    border-bottom: 6px solid transparent;
    margin-left: 3px;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
  @keyframes carousel-progress {
    to {
      width: 100%;
    }
  }
  @media (hover: hover) {
    .experience-visual:hover .experience-photo {
      transform: scale(1.045);
      filter: saturate(1.1);
    }
    .experience-thumbnail:hover {
      opacity: 1;
      transform: translateY(-3px);
    }
    .experience-navigation button:hover {
      background: #5e8aaa5c;
      transform: translateY(-2px);
      box-shadow: 0 7px 18px #061d3333;
    }
  }
  @media (max-width: 1050px) {
    .experience-caption {
      padding: 28px;
    }
    .experience-visual {
      --visual-height: 390px;
    }
  }
  @media (max-width: 760px) {
    .experience-slide {
      grid-template-columns: 1fr;
    }
    .experience-visual {
      --visual-height: 300px;
    }
    .experience-caption {
      padding: 23px;
      min-height: 245px;
    }
    .experience-number {
      font-size: 24px;
      position: absolute;
      right: 23px;
      top: 19px;
      margin-top: 0;
    }
    .experience-caption .eyebrow {
      margin: 0 70px 13px 0;
      font-size: 7px;
    }
    .experience-caption h3 {
      font-size: 29px;
      max-width: 240px;
    }
    .experience-caption p {
      max-width: 100%;
    }
    .experience-signature {
      padding-top: 14px;
    }
    .experience-controls {
      flex-direction: column;
      gap: 17px;
      padding: 18px;
    }
    .experience-thumbnails {
      width: 100%;
      justify-content: space-between;
      gap: 8px;
    }
    .experience-thumbnail {
      width: calc((100% - 24px) / 4);
      height: 48px;
    }
    .experience-navigation {
      width: 100%;
    }
    .experience-count {
      margin-right: auto;
    }
    .experience-stamp {
      font-size: 7px;
      left: 20px;
      bottom: 20px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .experience-progress {
      display: none;
    }
  }
</style>
